# Local development only. Copy to .env and choose a password before starting PostgreSQL.
POSTGRES_DB=castravolt
POSTGRES_USER=castravolt
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
# Keep this password in sync with POSTGRES_PASSWORD; URL-encode reserved characters.
CASTRAVOLT_DATABASE_URL=postgresql+psycopg://castravolt:replace-with-a-local-password@127.0.0.1:5432/castravolt
CASTRAVOLT_CORS_ORIGINS=["http://localhost:5173"]
