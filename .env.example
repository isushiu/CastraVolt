# Local development only. Copy to .env and choose a password before starting PostgreSQL.
POSTGRES_DB=castravolt
POSTGRES_USER=castravolt
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=55432
# Keep this password in sync with POSTGRES_PASSWORD; URL-encode reserved characters.
CASTRAVOLT_DATABASE_URL=postgresql+psycopg://castravolt:replace-with-a-local-password@127.0.0.1:55432/castravolt
CASTRAVOLT_CORS_ORIGINS=["http://localhost:5173"]
# Local account emails are captured here instead of being sent externally.
CASTRAVOLT_FRONTEND_URL=http://127.0.0.1:5173
CASTRAVOLT_MAIL_MODE=file
CASTRAVOLT_MAIL_DIRECTORY=tmp/mailbox
CASTRAVOLT_SECURE_COOKIES=false

# Internal development: shared admin / 123, no public registration.
CASTRAVOLT_INTERNAL_ACCESS=true

# Explicit submitted address search; public service is for low-volume development.
CASTRAVOLT_GEOCODER_URL=https://nominatim.openstreetmap.org
CASTRAVOLT_GEOCODER_USER_AGENT="CastraVolt/0.1 (urban EV planning research prototype)"
# Optional tile overrides go in frontend/.env.local:
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=...provider-required attribution...
