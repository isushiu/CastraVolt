{
  "openapi": "3.1.0",
  "info": {
    "title": "CastraVolt API",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system": {
      "get": {
        "summary": "System",
        "operationId": "system_api_v1_system_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Liveness": {
        "properties": {
          "status": {
            "type": "string",
            "const": "alive",
            "title": "Status",
            "default": "alive"
          }
        },
        "type": "object",
        "title": "Liveness"
      },
      "Readiness": {
        "properties": {
          "scope": {
            "type": "string",
            "const": "foundation",
            "title": "Scope",
            "default": "foundation"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "connected",
              "not_configured",
              "unavailable"
            ],
            "title": "Database"
          },
          "predictions_available": {
            "type": "boolean",
            "title": "Predictions Available",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "Readiness"
      },
      "SystemInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "default": "CastraVolt"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          },
          "stage": {
            "type": "string",
            "const": "foundation",
            "title": "Stage",
            "default": "foundation"
          },
          "capabilities": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Capabilities",
            "default": {
              "accounts": false,
              "projects": false,
              "predictions": false
            }
          }
        },
        "type": "object",
        "title": "SystemInfo"
      }
    }
  }
}